# Database Configuration
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
DB_PASSWORD=YOUR_PASSWORD

# Authentication
JWT_SECRET=your_secure_random_jwt_secret_here
# To generate a new secure secret, run: openssl rand -hex 32

# AI Configuration (Gemini)
# If empty, the system will use a mock fallback
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (For Storage & Realtime features if applicable)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Twilio (OTP Verification)
OTP_PROVIDER=development
OTP_DEMO_MODE=true
DEMO_OTP=123456
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Admin Dashboard Defaults
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Frontend Config
VITE_API_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=["http://localhost:5173", "https://your-production-url.vercel.app"]
